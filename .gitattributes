# 文本换行/编码规范：避免 Windows 检出把 shell/文档改坏
* text=auto
*.md text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.html text eol=lf
logrotate.d-* text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
# 二进制：不做换行/合并处理
*.png binary
*.jpg binary
*.jpeg binary
*.apk binary
*.jar binary
*.p12 binary
*.gz binary
*.tgz binary
*.zip binary
