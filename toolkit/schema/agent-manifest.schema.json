{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://haydn-server.local/toolkit/schema/agent-manifest.schema.json",
  "title": "repurpose.agent-manifest.v1",
  "description": "由 python -m toolkit.repurpose index 生成的机器索引（仓库根 agent-manifest.json）。生成物不要手改；内容变更后必须重建。本文件是自描述 JSON，供人/Agent/外部校验器阅读。",
  "type": "object",
  "required": [
    "schema",
    "generated_at",
    "repo",
    "entrypoints",
    "reading_order",
    "content",
    "tools",
    "invariants",
    "commands",
    "counts",
    "warnings",
    "errors"
  ],
  "properties": {
    "schema": {"const": "repurpose.agent-manifest.v1"},
    "generated_at": {"type": "string", "description": "UTC ISO-8601；validate 用它判断索引是否过期"},
    "repo": {
      "type": "object",
      "required": ["name", "root"],
      "properties": {
        "name": {"type": "string", "description": "仓库目录名（不写绝对路径）"},
        "root": {"const": "."},
        "protocol": {
          "type": "array",
          "items": {"type": "string"},
          "description": "根协议文件（AGENTS.md/backlog.json/README.md，存在时列出）"
        }
      },
      "additionalProperties": true
    },
    "entrypoints": {
      "type": "array",
      "items": {"$ref": "#/definitions/readingStep"},
      "description": "索引/入口文档（MTH-000、TOOL-000、PIT-000、GRD-000、CASE-000）"
    },
    "reading_order": {
      "type": "array",
      "items": {"$ref": "#/definitions/readingStep"},
      "description": "Agent 阅读顺序：方法论 → 工具 → 案例 → 护栏 → 踩坑"
    },
    "content": {
      "type": "object",
      "required": ["methodology", "pitfalls", "guardrails", "case_studies"],
      "properties": {
        "methodology": {"type": "array", "items": {"$ref": "#/definitions/entry"}},
        "pitfalls": {"type": "array", "items": {"$ref": "#/definitions/entry"}},
        "guardrails": {"type": "array", "items": {"$ref": "#/definitions/entry"}},
        "case_studies": {"type": "array", "items": {"$ref": "#/definitions/entry"}}
      },
      "additionalProperties": true
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind", "path"],
        "properties": {
          "name": {"type": "string"},
          "kind": {"enum": ["cli", "wrapper", "termux", "script", "other"]},
          "path": {"type": "string", "description": "仓库相对路径"},
          "entry": {"type": "string"},
          "commands": {"type": "array", "items": {"type": "string"}},
          "description": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "invariants": {
      "type": "array",
      "items": {"type": "string"},
      "description": "红线摘要（来自 AGENTS.md/guardrails）"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "cmd"],
        "properties": {
          "name": {"type": "string"},
          "cmd": {"type": "string"},
          "note": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "counts": {
      "type": "object",
      "required": ["methodology", "pitfalls", "guardrails", "case_studies", "tools", "entrypoints", "reading_order"],
      "properties": {
        "methodology": {"type": "integer", "minimum": 0},
        "pitfalls": {"type": "integer", "minimum": 0},
        "guardrails": {"type": "integer", "minimum": 0},
        "case_studies": {"type": "integer", "minimum": 0},
        "tools": {"type": "integer", "minimum": 0},
        "entrypoints": {"type": "integer", "minimum": 0},
        "reading_order": {"type": "integer", "minimum": 0},
        "total_entry_docs": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string"}}
  },
  "definitions": {
    "entry": {
      "type": "object",
      "required": ["id", "title", "type", "status", "audience", "tags", "updated", "agent_hint", "path"],
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "type": {"type": "string"},
        "status": {"type": "string"},
        "audience": {"type": "array", "items": {"type": "string"}},
        "tags": {"type": "array", "items": {"type": "string"}},
        "updated": {"type": "string"},
        "agent_hint": {"type": "string"},
        "depends": {"type": "array", "items": {"type": "string"}},
        "path": {"type": "string", "description": "仓库相对路径（POSIX 分隔符）"},
        "severity": {"type": "string"},
        "domain": {"type": "string"},
        "scope": {"type": "string"},
        "oem": {"type": "string"}
      },
      "additionalProperties": true
    },
    "readingStep": {
      "type": "object",
      "required": ["step", "id", "path", "title", "reason"],
      "properties": {
        "step": {"type": "integer", "minimum": 1},
        "id": {"type": "string"},
        "path": {"type": "string"},
        "title": {"type": "string"},
        "reason": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
