# Vaultwarden 非敏感配置（部署到 chroot: /etc/haydn/vaultwarden.env，600）
# ADMIN_TOKEN 不在此文件：由 /opt/haydn/bin/vaultwarden-run.sh 从
# /opt/haydn/secrets/vaultwarden-admin-token（600）读入环境。
DOMAIN=https://vault.qingxuan.bbs0.cc
ROCKET_ADDRESS=127.0.0.1
ROCKET_PORT=18084
DATA_FOLDER=/srv/haydn/vaultwarden
WEB_VAULT_FOLDER=/opt/haydn/vaultwarden-web-vault
WEB_VAULT_ENABLED=true
SIGNUPS_ALLOWED=true
SIGNUPS_VERIFY=false
INVITATIONS_ALLOWED=false
IP_HEADER=none
LOG_LEVEL=info
EXTENDED_LOGGING=true
