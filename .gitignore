# ---- 平台/构建工具（体积大、可重新下载，不入库）----
/tools/platform-tools/
/tools/android-sdk/
/tools/*.zip
/tools/mi-unlock/
/tools/magisk/
/tools/firmware/
/tools/termux/
/tools/termux-boot/
/tools/apks/
/tools/uad_lists.json

# ---- 备份与刷机物料（含个人数据/大文件）----
/backup/

# ---- 采集产物（含设备序列号等隐私，重新运行脚本即可生成）----
/inventory/*
# 但保留说明文件
!/inventory/README.md

# ---- Android Bridge 构建产物 / 私钥（绝不可提交）----
/android-bridge/build/
/android-bridge/assets/bridge.p12
/android-bridge/signing.p12
/android-bridge/certs/
/android-bridge/_tmp*

